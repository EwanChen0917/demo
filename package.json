{
  "name": "vue3-monorepo",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen:api": "pnpm --filter @app/main run gen:api",
    "dev:main": "pnpm --filter @app/main dev",
    "dev:main:host": "pnpm --filter @app/main dev -- --host 0.0.0.0 --port 5172",
    "preview:main": "pnpm --filter @app/main exec vite preview --host 127.0.0.1 --port 4173",
    "preview": "pnpm run preview:main",
    "dev": "pnpm run dev:main --mode dev",
    "dev:host": "pnpm run dev:main:host",
    "build:shared": "pnpm --filter @app/shared build",
    "build:a": "pnpm --filter @app/a build",
    "build:b": "pnpm --filter @app/b build",
    "build:a:preview": "pnpm run build:a && pnpm run build:main",
    "build:types": "pnpm --filter @app/a build:types && pnpm --filter @app/b build:types",
    "build:main": "pnpm --filter @app/main build",
    "build": "rm -rf dist && pnpm -r --filter \"./packages/**\" --if-present run build",
    "build:check:externals": "node scripts/check-subpackage-externals.mjs",
    "build:ci": "pnpm run build && pnpm run build:check:externals",
    "lint": "pnpm run lint:main && pnpm run lint:a && pnpm run lint:b",
    "lint:main": "pnpm --filter @app/main lint",
    "lint:a": "pnpm --filter @app/a lint",
    "lint:b": "pnpm --filter @app/b lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "prepare": "husky"
  },
  "dependencies": {
    "@lute-root-ui/element-plus": "^1.0.36",
    "@vue-flow/core": "^1.48.2",
    "fast-glob": "^3.3.3",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vxe-pc-ui": "^4.14.12",
    "vxe-table": "^4.18.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.22.0",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "sass": "catalog:",
    "terser": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-svg-icons": "^2.0.1"
  }
}
