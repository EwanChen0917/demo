{
  "name": "vue3-monorepo",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:main": "pnpm --filter @app/main dev",
    "dev:main:host": "pnpm --filter @app/main dev -- --host 0.0.0.0 --port 5172",
    "preview:main": "pnpm --filter @app/main exec vite preview --host 127.0.0.1 --port 4173",
    "preview": "pnpm run preview:main",
    "dev": "pnpm run dev:main",
    "dev:host": "pnpm run dev:main:host",
    "build:shared": "pnpm --filter @app/shared build",
    "build:a": "pnpm --filter @app/a build",
    "build:b": "pnpm --filter @app/b build",
    "build:a:preview": "pnpm run build:a && pnpm run build:main",
    "build:types": "pnpm --filter @app/a build:types && pnpm --filter @app/b build:types",
    "build:main": "pnpm --filter @app/main build",
    "build": "rm -rf dist && pnpm -r --filter \"./packages/**\" --if-present run build",
    "lint": "pnpm run lint:main && pnpm run lint:a && pnpm run lint:b",
    "lint:main": "pnpm --filter @app/main lint",
    "lint:a": "pnpm --filter @app/a lint",
    "lint:b": "pnpm --filter @app/b lint",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "prepare": "husky"
  },
  "dependencies": {
    "element-plus": "catalog:",
    "fast-glob": "^3.3.3",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "husky": "^9.1.7",
    "sass": "catalog:",
    "terser": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-svg-icons": "^2.0.1"
  }
}
