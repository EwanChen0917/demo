    { "path": "./packages/shared" },
    { "path": "./packages/main" },
    { "path": "./packages/a" },
    { "path": "./packages/b" }
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
