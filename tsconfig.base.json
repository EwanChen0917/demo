{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@app/shared": ["./packages/shared/src/index.ts"],
      "@app/a": ["./dist/a/index.d.ts"],
      "@app/b": ["./dist/b/index.d.ts"]
    },
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "composite": true,
    "declaration": true,
    "declarationMap": true
  }
}
